#!/usr/bin/env python3
"""Tiny Sonos UPnP client for the Sonos bar widget. Standard library only.

  sonos [--hosts ip,ip] serve           long-running mode for the widget: JSON lines in and out
  sonos [--hosts ip,ip] status          JSON for every group
  sonos playlists                       JSON for your Spotify playlists
  sonos play|pause|next|prev <ip>       transport control on a group coordinator
  sonos volume <ip> <0-100>             group volume
  sonos speaker-volume <ip> <0-100>     volume of one speaker inside a group
  sonos lead <group ip> <speaker uuid>  make another speaker lead the group
  sonos mute <ip> on|off                mute a group
  sonos play-mode <ip> <mode>           NORMAL, REPEAT_ALL, REPEAT_ONE, SHUFFLE_NOREPEAT,
                                        SHUFFLE or SHUFFLE_REPEAT_ONE
  sonos source <ip> tv|line-in <uuid>   play a speaker's TV or line-in input on a group
  sonos join <ip> <coordinator-uuid>    add a speaker to a group
  sonos leave <ip> [heir-uuid]          take a speaker out of its group; a coordinator
                                        first hands the group (and playback) to the heir
  sonos search <query>                  Spotify tracks, albums and playlists
  sonos play-uri <ip> <spotify:uri>     replace the queue with a Spotify item and play it
  sonos spotify-status                  whether Spotify is logged in
  sonos spotify-login <client-id>       log in through the browser (OAuth with PKCE)
  sonos spotify-logout                  forget the login, keep the client ID

`serve` also shows the group the widget points at as a media player
(MPRIS) when python-gobject is installed, so media keys control Sonos.

Search uses the Spotify Web API with the login saved in ~/.config/omasonos/spotify.json.
Playback goes through the Spotify account already linked in Sonos.

Speaker IPs are cached so status never waits on discovery once one is known.

Speed is the point. `serve` keeps one process alive so a click never waits for
Python to start, polls every second while the popup is open, confirms a
control about 250 ms after it lands and keeps the Spotify connection warm.
Speakers on Wi-Fi sometimes drop the first packet of a connection and TCP
waits a full second to retry, so every connection races a fresh attempt
every 150 ms instead. While the popup is open each speaker also has a
connection opened in advance, so a click skips connecting altogether.
"""
import base64
import http.client
import ipaddress
import json
import os
import re
import select
import socket
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor, as_completed
from xml.etree import ElementTree as ET
from xml.sax.saxutils import escape

CACHE_DIR = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
CACHE = os.path.join(CACHE_DIR, "omasonos.json")
TOKEN_CACHE = os.path.join(CACHE_DIR, "omasonos-spotify-token.json")
SPOTIFY_CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                            "omasonos", "spotify.json")
PORT = int(os.environ.get("OMASONOS_PORT", "1400"))
TIMEOUT = 2
MPRIS = os.environ.get("OMASONOS_MPRIS", "1") != "0"
PATHS = {
    "AVTransport": "/MediaRenderer/AVTransport/Control",
    "GroupRenderingControl": "/MediaRenderer/GroupRenderingControl/Control",
    "RenderingControl": "/MediaRenderer/RenderingControl/Control",
    "ZoneGroupTopology": "/ZoneGroupTopology/Control",
    "MusicServices": "/MusicServices/Control",
}
INPUTS_CACHE = os.path.join(CACHE_DIR, "omasonos-inputs.json")
HEDGE = 0.15


def connect(ip):
    """Start a fresh connection attempt every HEDGE seconds until one answers, so a
    dropped first packet costs 150 ms instead of TCP's one-second retry."""
    pending = []
    deadline = time.monotonic() + TIMEOUT
    try:
        while True:
            left = deadline - time.monotonic()
            if left <= 0:
                raise TimeoutError(f"{ip} did not answer")
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.setblocking(False)
            s.connect_ex((ip, PORT))
            pending.append(s)
            _, ready, _ = select.select([], pending, [], min(HEDGE, left))
            for s in ready:
                err = s.getsockopt(socket.SOL_SOCKET, socket.SO_ERROR)
                if err:
                    raise OSError(err, os.strerror(err))
                pending.remove(s)
                s.setblocking(True)
                s.settimeout(TIMEOUT)
                return s
    finally:
        for s in pending:
            s.close()


# While the popup is open the helper keeps one connected socket per speaker, so
# a click skips connecting. Speakers drop an unused connection after 5–15 s,
# so spares are replaced before SPARE_AGE.
SPARE_AGE = 6
spares = {}  # ip -> (socket, opened at)
spares_lock = threading.Lock()


def take_spare(ip):
    with spares_lock:
        sock, opened = spares.pop(ip, (None, 0))
    if sock and time.monotonic() - opened < SPARE_AGE:
        return sock
    if sock:
        sock.close()
    return None


def add_spare(ip):
    try:
        sock = connect(ip)
    except OSError:
        return
    with spares_lock:
        old = spares.pop(ip, (None, 0))[0]
        spares[ip] = (sock, time.monotonic())
    if old:
        old.close()


def exchange(sock, request):
    with sock:
        sock.sendall(request)
        chunks = []
        while chunk := sock.recv(65536):
            chunks.append(chunk)
    return b"".join(chunks)


class SpeakerError(RuntimeError):
    """A speaker answered but refused the action."""

    # UPnP error codes speakers return, in words people understand.
    REASONS = {701: "not possible right now", 711: "not supported for this source",
               712: "not supported for this source", 714: "not supported for this source",
               800: "the speaker refused", 804: "the speaker refused"}

    def __init__(self, code):
        self.code = code
        super().__init__(self.REASONS.get(code, f"the speaker refused (error {code})"))


def soap(ip, service, action, args="<InstanceID>0</InstanceID>", spare=False):
    body = (
        '<?xml version="1.0"?><s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/" '
        's:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"><s:Body>'
        f'<u:{action} xmlns:u="urn:schemas-upnp-org:service:{service}:1">{args}</u:{action}>'
        "</s:Body></s:Envelope>"
    ).encode()
    head = (
        f"POST {PATHS[service]} HTTP/1.1\r\nHost: {ip}:{PORT}\r\nConnection: close\r\n"
        f'Content-Type: text/xml; charset="utf-8"\r\nContent-Length: {len(body)}\r\n'
        f'SOAPACTION: "urn:schemas-upnp-org:service:{service}:1#{action}"\r\n\r\n'
    ).encode()
    raw = b""
    sock = take_spare(ip) if spare else None
    if sock:
        try:
            raw = exchange(sock, head + body)
        except OSError:
            pass
    # An empty answer means the speaker had already dropped the spare unread.
    if not raw:
        raw = exchange(connect(ip), head + body)
    header, _, payload = raw.partition(b"\r\n\r\n")
    ok = b" 200 " in header.split(b"\r\n", 1)[0]
    if b"chunked" in header.lower():
        out, rest = [], payload
        while rest:
            size, _, rest = rest.partition(b"\r\n")
            n = int(size.split(b";")[0] or b"0", 16)
            if n == 0:
                break
            out.append(rest[:n])
            rest = rest[n + 2:]
        payload = b"".join(out)
    if not ok:
        code = re.search(rb"<errorCode>(\d+)</errorCode>", payload)
        raise SpeakerError(int(code.group(1)) if code else 0)
    resp = ET.fromstring(payload).find(f".//{{*}}{action}Response")
    return {c.tag: c.text or "" for c in resp} if resp is not None else {}


def topology(ip):
    state = ET.fromstring(soap(ip, "ZoneGroupTopology", "GetZoneGroupState", "")["ZoneGroupState"])
    groups = []
    for g in state.iter("ZoneGroup"):
        members = [m for m in g.findall("ZoneGroupMember")
                   if m.get("Invisible") != "1" and m.get("IsZoneBridge") != "1"]
        coord = next((m for m in members if m.get("UUID") == g.get("Coordinator")), None)
        if coord is None:
            continue
        host = lambda m: re.search(r"//([^:/]+)", m.get("Location", "")).group(1)
        rooms = sorted({m.get("ZoneName", "") for m in members})
        groups.append({"ip": host(coord), "uuid": coord.get("UUID"), "name": " + ".join(rooms),
                       "members": [{"name": m.get("ZoneName", ""), "ip": host(m), "uuid": m.get("UUID"),
                                    "group": host(coord)} for m in members]})
    return groups


def local_networks():
    """The private IPv4 networks this machine is on; empty when offline."""
    out = subprocess.run(["ip", "-4", "-o", "addr", "show", "scope", "global"],
                         capture_output=True, text=True).stdout
    return tuple(sorted({ipaddress.ip_interface(c).network for c in re.findall(r"inet (\S+)", out)
                         if ipaddress.ip_interface(c).network.is_private}, key=str))


def on_networks(ip, nets):
    try:
        addr = ipaddress.ip_address(ip)
        return addr.is_loopback or any(addr in n for n in nets)
    except ValueError:
        return False


def discover(nets):
    """SSDP first; if multicast is filtered, scan the local /24s for port 1400."""
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.settimeout(1)
    msg = (b'M-SEARCH * HTTP/1.1\r\nHOST: 239.255.255.250:1900\r\nMAN: "ssdp:discover"\r\n'
           b"MX: 1\r\nST: urn:schemas-upnp-org:device:ZonePlayer:1\r\n\r\n")
    try:
        for _ in range(2):
            s.sendto(msg, ("239.255.255.250", 1900))
        return [s.recvfrom(1024)[1][0]]
    except OSError:
        pass

    hosts = []
    for net in nets:
        if net.prefixlen >= 22 and not net.subnet_of(ipaddress.ip_network("172.16.0.0/12")):
            hosts += [str(h) for h in net.hosts()]

    def probe(h):
        try:
            socket.create_connection((h, PORT), 0.4).close()
            return h
        except OSError:
            return None

    with ThreadPoolExecutor(128) as ex:
        return [h for h in ex.map(probe, hosts) if h]


def first_topology(candidates):
    """Ask the first candidate; if it fails, ask all the others at once."""
    candidates = list(dict.fromkeys(candidates))
    if not candidates:
        return None
    try:
        return topology(candidates[0]) or None
    except Exception:
        pass
    rest = candidates[1:]
    if not rest:
        return None
    with ThreadPoolExecutor(len(rest)) as ex:
        for fut in as_completed([ex.submit(topology, ip) for ip in rest]):
            try:
                if groups := fut.result():
                    return groups
            except Exception:
                pass
    return None


def cached_hosts():
    try:
        with open(CACHE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return []


def save_hosts(groups):
    hosts = sorted({m["ip"] for g in groups for m in g["members"]})
    if hosts == cached_hosts():
        return
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    with open(CACHE, "w") as f:
        json.dump(hosts, f)


def known_hosts(manual, preferred, nets):
    """Manual hosts, then remembered speakers on the networks we're on now."""
    return [*manual, *(ip for ip in [*preferred, *cached_hosts()] if on_networks(ip, nets))]


def load_groups(manual, preferred=()):
    nets = local_networks()
    if not nets and not manual:
        raise RuntimeError("No network")
    groups = first_topology(known_hosts(manual, preferred, nets)) or first_topology(discover(nets))
    if groups:
        save_hosts(groups)
    return groups or []


def text(node, tag):
    found = node.find(f".//{{*}}{tag}")
    return found.text or "" if found is not None else ""


def seconds(clock):
    try:
        h, m, s = (int(x) for x in clock.split(":"))
        return h * 3600 + m * 60 + s
    except ValueError:
        return 0


def now_playing(ip):
    pos = soap(ip, "AVTransport", "GetPositionInfo")
    uri = pos.get("TrackURI", "")
    track = {"title": "", "artist": "", "album": "", "art": "", "source": "",
             "position": seconds(pos.get("RelTime", "")), "duration": seconds(pos.get("TrackDuration", ""))}
    if uri.startswith("x-sonos-htastream"):
        return {**track, "title": "TV", "source": "tv"}
    if uri.startswith("x-rincon-stream"):
        return {**track, "title": "Line-in", "source": "line-in"}
    try:
        meta = ET.fromstring(pos.get("TrackMetaData", ""))
    except ET.ParseError:
        return track
    art = text(meta, "albumArtURI")
    return {
        **track,
        "title": text(meta, "streamContent") or text(meta, "title"),
        "artist": text(meta, "creator"),
        "album": text(meta, "album"),
        "art": f"http://{ip}:{PORT}{art}" if art.startswith("/") else art,
    }


def speaker_inputs(ip):
    """TV and line-in inputs a speaker has, from its device description."""
    with connect(ip) as sock:
        sock.sendall(f"GET /xml/device_description.xml HTTP/1.1\r\nHost: {ip}:{PORT}\r\nConnection: close\r\n\r\n".encode())
        chunks = []
        while chunk := sock.recv(65536):
            chunks.append(chunk)
    desc = b"".join(chunks)
    return ([] if b"service:HTControl:" not in desc else ["tv"]) + \
           ([] if b"service:AudioIn:" not in desc else ["line-in"])


def inputs_for(rooms, pool):
    """Inputs per speaker uuid; hardware doesn't change, so answers are cached."""
    try:
        with open(INPUTS_CACHE) as f:
            known = json.load(f)
    except (OSError, ValueError):
        known = {}
    missing = [(r, pool.submit(speaker_inputs, r["ip"])) for r in rooms if r["uuid"] not in known]
    for r, fut in missing:
        try:
            known[r["uuid"]] = fut.result()
        except Exception:
            pass
    if missing:
        os.makedirs(CACHE_DIR, exist_ok=True)
        with open(INPUTS_CACHE, "w") as f:
            json.dump(known, f)
    return known


def speaker_volume(ip):
    return int(soap(ip, "RenderingControl", "GetVolume",
                    "<InstanceID>0</InstanceID><Channel>Master</Channel>")["CurrentVolume"])


def fill(group, pool):
    """Ask for state, volume and track at once; returns a function that waits for them."""
    ip = group["ip"]
    calls = {
        "state": pool.submit(lambda: soap(ip, "AVTransport", "GetTransportInfo")["CurrentTransportState"]),
        "volume": pool.submit(lambda: int(soap(ip, "GroupRenderingControl", "GetGroupVolume")["CurrentVolume"])),
        "track": pool.submit(now_playing, ip),
        "muted": pool.submit(lambda: soap(ip, "GroupRenderingControl", "GetGroupMute")["CurrentMute"] == "1"),
        "playMode": pool.submit(lambda: soap(ip, "AVTransport", "GetTransportSettings")["PlayMode"]),
    }
    defaults = {"state": "", "volume": 0, "muted": False, "playMode": "NORMAL"}

    def collect():
        for key, fut in calls.items():
            try:
                value = fut.result()
            except Exception:
                value = {} if key == "track" else defaults[key]
            if key == "track":
                group.update(value)
            else:
                group[key] = value
        return group
    return collect


def status(groups, pool):
    rooms = sorted((m for g in groups for m in g.pop("members")), key=lambda m: m["name"].lower())
    volumes = [(r, pool.submit(speaker_volume, r["ip"])) for r in rooms]
    groups = [collect() for collect in [fill(g, pool) for g in groups]]
    inputs = inputs_for(rooms, pool)
    for r, fut in volumes:
        try:
            r["volume"] = fut.result()
        except Exception:
            r["volume"] = 0
        r["inputs"] = inputs.get(r["uuid"], [])
    return {"groups": sorted(groups, key=lambda g: g["name"].lower()), "rooms": rooms}


def spotify_conf():
    try:
        with open(SPOTIFY_CONF) as f:
            return json.load(f)
    except (OSError, ValueError):
        raise RuntimeError("Log in to Spotify first")


def write_private(path, data):
    """Write JSON readable only by the owner. A fresh file is created owner-only and
    swapped in, so an older file with looser permissions never keeps them."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with open(fd, "w") as f:
            json.dump(data, f)
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.remove(tmp)
        raise


def save_spotify_conf(conf):
    write_private(SPOTIFY_CONF, conf)


def token_request(params, auth=None):
    headers = {"Content-Type": "application/x-www-form-urlencoded"}
    if auth:
        headers["Authorization"] = "Basic " + base64.b64encode(auth.encode()).decode()
    req = urllib.request.Request("https://accounts.spotify.com/api/token",
                                 urllib.parse.urlencode(params).encode(), headers)
    try:
        with urllib.request.urlopen(req, timeout=5) as r:
            data = json.load(r)
    except urllib.error.HTTPError as e:
        raise RuntimeError("Spotify login expired, log in again" if e.code in (400, 401) else f"Spotify error {e.code}")
    write_private(TOKEN_CACHE, {"token": data["access_token"], "expires": time.time() + data["expires_in"]})
    return data


def spotify_token():
    try:
        # Older versions wrote this file world-readable; tighten it if so.
        if os.stat(TOKEN_CACHE).st_mode & 0o077:
            os.chmod(TOKEN_CACHE, 0o600)
        with open(TOKEN_CACHE) as f:
            cached = json.load(f)
        if cached["expires"] > time.time() + 60:
            return cached["token"]
    except (OSError, ValueError, KeyError):
        pass
    conf = spotify_conf()
    if "refresh_token" not in conf and "client_secret" not in conf:
        raise RuntimeError("Log in to Spotify first")
    if "refresh_token" not in conf:  # older setup with a client secret
        return token_request({"grant_type": "client_credentials"},
                             f"{conf['client_id']}:{conf['client_secret']}")["access_token"]
    data = token_request({"grant_type": "refresh_token", "refresh_token": conf["refresh_token"],
                          "client_id": conf["client_id"]})
    if data.get("refresh_token", conf["refresh_token"]) != conf["refresh_token"]:
        save_spotify_conf({**conf, "refresh_token": data["refresh_token"]})
    return data["access_token"]


REDIRECT = "http://127.0.0.1:8888/callback"


def spotify_login(client_id):
    """Authorization code flow with PKCE: no client secret, one approval in the browser."""
    import hashlib
    import http.server
    import secrets
    import shutil

    verifier = secrets.token_urlsafe(64)
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
    state = secrets.token_urlsafe(16)
    reply = {}

    class Callback(http.server.BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass

        def do_GET(self):
            url = urllib.parse.urlsplit(self.path)
            if url.path != "/callback":
                self.send_error(404)
                return
            reply.update(urllib.parse.parse_qsl(url.query))
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write("<body style='font:16px sans-serif;text-align:center;margin-top:20vh'>"
                             "Spotify is connected. You can close this tab.</body>".encode())

    try:
        server = http.server.HTTPServer(("127.0.0.1", 8888), Callback)
    except OSError:
        raise RuntimeError("Port 8888 is busy; close what uses it and try again")
    server.timeout = 1

    url = "https://accounts.spotify.com/authorize?" + urllib.parse.urlencode({
        "client_id": client_id, "response_type": "code", "redirect_uri": REDIRECT, "state": state,
        "code_challenge_method": "S256", "code_challenge": challenge,
        "scope": "user-library-read playlist-read-private",
    })
    browser = shutil.which("omarchy-launch-browser") or "xdg-open"
    subprocess.Popen([browser, url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

    deadline = time.time() + 180
    while not reply and time.time() < deadline:
        server.handle_request()
    server.server_close()

    if not reply:
        raise RuntimeError("Login timed out")
    if reply.get("state") != state or "code" not in reply:
        raise RuntimeError("Spotify login was cancelled")
    data = token_request({"grant_type": "authorization_code", "code": reply["code"], "redirect_uri": REDIRECT,
                          "client_id": client_id, "code_verifier": verifier})
    save_spotify_conf({"client_id": client_id, "refresh_token": data["refresh_token"]})


class SpotifyApi:
    """One kept-alive HTTPS connection, so a search skips the TCP and TLS handshakes."""

    def __init__(self):
        self.conn = None

    def warm(self):
        if self.conn is None:
            self.conn = http.client.HTTPSConnection("api.spotify.com", timeout=5)
            self.conn.connect()

    def get(self, path):
        for attempt in (0, 1):
            try:
                self.warm()
                self.conn.request("GET", path, headers={"Authorization": f"Bearer {spotify_token()}"})
                r = self.conn.getresponse()
                data = r.read()
                if r.status == 401 and attempt == 0 and os.path.exists(TOKEN_CACHE):
                    os.remove(TOKEN_CACHE)  # token revoked early: fetch a new one and retry
                    continue
                if r.status == 401:
                    raise RuntimeError("Spotify login expired, log in again")
                if r.status != 200:
                    raise RuntimeError(f"Spotify error {r.status}")
                return json.loads(data)
            except (OSError, http.client.HTTPException):
                if self.conn:
                    self.conn.close()
                self.conn = None
                if attempt:
                    raise RuntimeError("Spotify is unreachable")
        raise RuntimeError("Spotify login expired, log in again")


def search(query, api=None):
    params = urllib.parse.urlencode({"q": query, "type": "track,album,playlist", "limit": 5})
    data = (api or SpotifyApi()).get(f"/v1/search?{params}")

    def art(item):
        images = item.get("images") or item.get("album", {}).get("images") or []
        return images[-1]["url"] if images else ""

    def artists(item):
        return ", ".join(a["name"] for a in item.get("artists", []))

    results = []
    for t in data.get("tracks", {}).get("items", []):
        results.append({"uri": t["uri"], "title": t["name"], "subtitle": artists(t), "art": art(t)})
    for a in data.get("albums", {}).get("items", []):
        results.append({"uri": a["uri"], "title": a["name"], "subtitle": "Album · " + artists(a), "art": art(a)})
    for p in filter(None, data.get("playlists", {}).get("items", [])):
        owner = (p.get("owner") or {}).get("display_name") or ""
        results.append({"uri": p["uri"], "title": p["name"], "subtitle": "Playlist · " + owner, "art": art(p)})
    return results



# Asked for instead of a search when the widget opens its playlist list.
MY_PLAYLISTS = ":playlists"


def my_playlists(api=None):
    """The user's own and followed playlists, as many as Spotify returns in four pages."""
    api = api or SpotifyApi()
    results, path = [], "/v1/me/playlists?limit=50"
    for _ in range(4):
        data = api.get(path)
        for p in filter(None, data.get("items", [])):
            images = p.get("images") or []
            # Spotify renamed a playlist's "tracks" to "items" in Feb 2026.
            total = (p.get("items") or p.get("tracks") or {}).get("total")
            count = f"{total} song{'' if total == 1 else 's'}" if isinstance(total, int) else ""
            results.append({"uri": p["uri"], "title": p["name"],
                            "subtitle": " · ".join(filter(None, ["Playlist", count])),
                            "art": images[-1]["url"] if images else ""})
        nxt = data.get("next")
        if not nxt:
            break
        path = nxt.split("api.spotify.com", 1)[-1]
    return results

# Sonos-side identifiers for Spotify items, as the Sonos app builds them.
SPOTIFY_ITEMS = {
    "track": ("", "00032020", "object.item.audioItem.musicTrack"),
    "album": ("x-rincon-cpcontainer:1004206c", "1004206c", "object.container.album.musicAlbum"),
    "playlist": ("x-rincon-cpcontainer:1006206c", "1006206c", "object.container.playlistContainer"),
}


def spotify_service(ip):
    """Sonos' id for the household's Spotify account type: 2311 in Europe, 3079 in the
    US. A manual "sonos_service" in spotify.json wins; otherwise ask the speaker."""
    try:
        if service := spotify_conf().get("sonos_service"):
            return service
    except RuntimeError:
        pass
    services = soap(ip, "MusicServices", "ListAvailableServices", "").get("AvailableServiceDescriptorList", "")
    for tag in re.findall(r"<Service [^>]*>", services):
        if 'Name="Spotify"' in tag and (sid := re.search(r'\bId="(\d+)"', tag)):
            return int(sid.group(1)) * 256 + 7
    return 2311


def play_uri(ip, uri, uuid=None, service=None):
    kind = uri.split(":")[1]
    prefix, key, item_class = SPOTIFY_ITEMS[kind]
    encoded = uri.replace(":", "%3a")
    service = service or spotify_service(ip)
    didl = (
        '<DIDL-Lite xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:upnp="urn:schemas-upnp-org:metadata-1-0/upnp/" '
        'xmlns:r="urn:schemas-rinconnetworks-com:metadata-1-0/" xmlns="urn:schemas-upnp-org:metadata-1-0/DIDL-Lite/">'
        f'<item id="{key}{encoded}" parentID="-1" restricted="true"><dc:title></dc:title>'
        f"<upnp:class>{item_class}</upnp:class>"
        '<desc id="cdudn" nameSpace="urn:schemas-rinconnetworks-com:metadata-1-0/">'
        f"SA_RINCON{service}_X_#Svc{service}-0-Token</desc></item></DIDL-Lite>"
    )
    uuid = uuid or next(g["uuid"] for g in topology(ip) if g["ip"] == ip)
    soap(ip, "AVTransport", "RemoveAllTracksFromQueue", spare=True)
    soap(ip, "AVTransport", "AddURIToQueue",
         f"<InstanceID>0</InstanceID><EnqueuedURI>{escape(prefix + encoded)}</EnqueuedURI>"
         f"<EnqueuedURIMetaData>{escape(didl)}</EnqueuedURIMetaData>"
         "<DesiredFirstTrackNumberEnqueued>0</DesiredFirstTrackNumberEnqueued><EnqueueAsNext>0</EnqueueAsNext>")
    soap(ip, "AVTransport", "SetAVTransportURI",
         f"<InstanceID>0</InstanceID><CurrentURI>x-rincon-queue:{uuid}#0</CurrentURI><CurrentURIMetaData></CurrentURIMetaData>")
    soap(ip, "AVTransport", "Play", "<InstanceID>0</InstanceID><Speed>1</Speed>")


CONTROLS = ("play", "pause", "next", "prev", "join", "leave", "lead", "volume", "speaker-volume",
            "mute", "play-mode", "source")
PLAY_MODES = ("NORMAL", "REPEAT_ALL", "REPEAT_ONE", "SHUFFLE_NOREPEAT", "SHUFFLE", "SHUFFLE_REPEAT_ONE")
MODE_PARTS = {"NORMAL": (False, ""), "REPEAT_ALL": (False, "all"), "REPEAT_ONE": (False, "one"),
              "SHUFFLE_NOREPEAT": (True, ""), "SHUFFLE": (True, "all"), "SHUFFLE_REPEAT_ONE": (True, "one")}


def play_mode(shuffle, repeat):
    return next(m for m, parts in MODE_PARTS.items() if parts == (bool(shuffle), repeat))


def describe(error):
    """A failure in words for the popup."""
    if isinstance(error, SpeakerError):
        return str(error)
    if isinstance(error, OSError):
        return "the speaker didn't answer"
    return str(error) or "something went wrong"


