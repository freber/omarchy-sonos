class Mpris:
    """Shows the group the widget points at as a desktop media player, so media
    keys and the shell's media controls reach Sonos. Needs python-gobject; without
    it the helper simply runs without this."""

    PATH = "/org/mpris/MediaPlayer2"

    def __init__(self, server, bus_name="org.mpris.MediaPlayer2.sonos"):
        from gi.repository import Gio, GLib
        self.Gio, self.GLib = Gio, GLib
        self.server = server
        self.group = None
        self.at = time.monotonic()
        self.conn = None
        self.sent = {}
        node = Gio.DBusNodeInfo.new_for_xml(MPRIS_XML)

        def acquired(conn, name):
            self.conn = conn
            register = getattr(conn, "register_object_with_closures2", None) or conn.register_object
            for iface in node.interfaces:
                register(self.PATH, iface, self.call, self.get, self.set)

        Gio.bus_own_name(Gio.BusType.SESSION, bus_name, Gio.BusNameOwnerFlags.NONE, acquired, None, None)
        threading.Thread(target=GLib.MainLoop().run, daemon=True).start()

    # ---- what the desktop sees
    def props(self):
        V, g = self.GLib.Variant, self.group or {}
        shuffle, repeat = MODE_PARTS.get(g.get("playMode", "NORMAL"), (False, ""))
        state = {"PLAYING": "Playing", "PAUSED_PLAYBACK": "Paused"}.get(g.get("state"), "Stopped")
        meta = {}
        if g.get("title"):
            meta = {"mpris:trackid": V("o", "/org/mpris/MediaPlayer2/sonos/track/%d" % (abs(hash((g["title"], g.get("artist")))) % 10 ** 9)),
                    "xesam:title": V("s", g["title"]),
                    "xesam:artist": V("as", [g["artist"]] if g.get("artist") else []),
                    "xesam:album": V("s", g.get("album", ""))}
            if g.get("art"):
                meta["mpris:artUrl"] = V("s", g["art"])
            if g.get("duration"):
                meta["mpris:length"] = V("x", g["duration"] * 1_000_000)
        control = bool(g)
        return {
            "org.mpris.MediaPlayer2": {
                "CanQuit": V("b", False), "CanRaise": V("b", False), "HasTrackList": V("b", False),
                "Identity": V("s", "Sonos · " + g["name"] if g else "Sonos"),
                "SupportedUriSchemes": V("as", []), "SupportedMimeTypes": V("as", []),
            },
            "org.mpris.MediaPlayer2.Player": {
                "PlaybackStatus": V("s", state),
                "LoopStatus": V("s", {"": "None", "all": "Playlist", "one": "Track"}[repeat]),
                "Shuffle": V("b", shuffle), "Rate": V("d", 1.0),
                "MinimumRate": V("d", 1.0), "MaximumRate": V("d", 1.0),
                "Metadata": V("a{sv}", meta), "Volume": V("d", g.get("volume", 0) / 100),
                "CanGoNext": V("b", control), "CanGoPrevious": V("b", control),
                "CanPlay": V("b", control), "CanPause": V("b", control),
                "CanSeek": V("b", False), "CanControl": V("b", control),
            },
        }

    def position(self):
        g = self.group or {}
        pos = g.get("position", 0) + (time.monotonic() - self.at if g.get("state") == "PLAYING" else 0)
        return int(min(pos, g.get("duration") or pos) * 1_000_000)

    def update(self, group):
        """New state from a poll or a control; tells listeners what changed."""
        self.group, self.at = group, time.monotonic()
        self.GLib.idle_add(self.announce)

    def announce(self):
        if self.conn:
            for iface, values in self.props().items():
                changed = {k: v for k, v in values.items() if self.sent.get((iface, k)) != v.print_(False)}
                for k, v in changed.items():
                    self.sent[(iface, k)] = v.print_(False)
                if changed:
                    self.conn.emit_signal(None, self.PATH, "org.freedesktop.DBus.Properties", "PropertiesChanged",
                                          self.GLib.Variant("(sa{sv}as)", (iface, changed, [])))
        return False

    # ---- what the desktop asks
    def get(self, conn, sender, path, iface, prop):
        if prop == "Position":
            return self.GLib.Variant("x", self.position())
        return self.props()[iface][prop]

    def set(self, conn, sender, path, iface, prop, value):
        g = self.group
        if not g:
            return False
        shuffle, repeat = MODE_PARTS.get(g.get("playMode", "NORMAL"), (False, ""))
        if prop == "Volume":
            self.server.handle({"cmd": "volume", "ip": g["ip"], "value": round(max(0, min(1, value.unpack())) * 100)})
        elif prop == "Shuffle":
            self.server.handle({"cmd": "play-mode", "ip": g["ip"], "arg": play_mode(value.unpack(), repeat)})
        elif prop == "LoopStatus":
            loop = {"None": "", "Playlist": "all", "Track": "one"}.get(value.unpack(), "")
            self.server.handle({"cmd": "play-mode", "ip": g["ip"], "arg": play_mode(shuffle, loop)})
        return True

    def call(self, conn, sender, path, iface, method, params, invocation):
        g = self.group
        if g and method in ("Play", "Pause", "PlayPause", "Stop", "Next", "Previous"):
            playing = g.get("state") == "PLAYING"
            cmd = {"Play": "play", "Pause": "pause", "Stop": "pause", "Next": "next", "Previous": "prev",
                   "PlayPause": "pause" if playing else "play"}[method]
            if cmd in ("play", "pause"):
                self.update({**g, "state": "PLAYING" if cmd == "play" else "PAUSED_PLAYBACK"})
            self.server.handle({"cmd": cmd, "ip": g["ip"]})
        invocation.return_value(None)


def control(cmd, ip, arg=None, extra=None):
    if cmd in ("play", "pause", "next", "prev"):
        action = {"play": "Play", "pause": "Pause", "next": "Next", "prev": "Previous"}[cmd]
        extra = "<Speed>1</Speed>" if cmd == "play" else ""
        soap(ip, "AVTransport", action, f"<InstanceID>0</InstanceID>{extra}", spare=True)
    elif cmd == "lead":
        # Hand the group to another member without stopping what plays. The speaker
        # only answers once the handover is done (often > TIMEOUT); the next status shows it.
        try:
            soap(ip, "AVTransport", "DelegateGroupCoordinationTo",
                 f"<InstanceID>0</InstanceID><NewCoordinator>{escape(arg)}</NewCoordinator><RejoinGroup>1</RejoinGroup>")
        except TimeoutError:
            pass
    elif cmd == "join":
        soap(ip, "AVTransport", "SetAVTransportURI",
             f"<InstanceID>0</InstanceID><CurrentURI>x-rincon:{escape(arg)}</CurrentURI><CurrentURIMetaData></CurrentURIMetaData>", spare=True)
    elif cmd == "leave" and arg:
        soap(ip, "AVTransport", "DelegateGroupCoordinationTo",
             f"<InstanceID>0</InstanceID><NewCoordinator>{escape(arg)}</NewCoordinator><RejoinGroup>0</RejoinGroup>", spare=True)
    elif cmd == "leave":
        soap(ip, "AVTransport", "BecomeCoordinatorOfStandaloneGroup", spare=True)
    elif cmd == "speaker-volume":
        level = max(0, min(100, int(arg)))
        soap(ip, "RenderingControl", "SetVolume",
             f"<InstanceID>0</InstanceID><Channel>Master</Channel><DesiredVolume>{level}</DesiredVolume>", spare=True)
    elif cmd == "volume":
        level = max(0, min(100, int(arg)))
        soap(ip, "GroupRenderingControl", "SetGroupVolume",
             f"<InstanceID>0</InstanceID><DesiredVolume>{level}</DesiredVolume>", spare=True)
    elif cmd == "mute":
        on = "1" if str(arg).lower() in ("1", "on", "true") else "0"
        soap(ip, "GroupRenderingControl", "SetGroupMute",
             f"<InstanceID>0</InstanceID><DesiredMute>{on}</DesiredMute>", spare=True)
    elif cmd == "play-mode":
        if arg not in PLAY_MODES:
            raise RuntimeError(f"Unknown play mode {arg}")
        soap(ip, "AVTransport", "SetPlayMode", f"<InstanceID>0</InstanceID><NewPlayMode>{arg}</NewPlayMode>", spare=True)
    elif cmd == "source":
        # TV comes from a soundbar's own input; line-in can play on any group.
        uri = f"x-sonos-htastream:{extra}:spdif" if arg == "tv" else f"x-rincon-stream:{extra}"
        soap(ip, "AVTransport", "SetAVTransportURI",
             f"<InstanceID>0</InstanceID><CurrentURI>{escape(uri)}</CurrentURI><CurrentURIMetaData></CurrentURIMetaData>",
             spare=True)
        soap(ip, "AVTransport", "Play", "<InstanceID>0</InstanceID><Speed>1</Speed>")


class Server:
    """Widget backend: commands arrive as JSON lines on stdin, status and search
    results leave as JSON lines on stdout. Exits when the widget closes stdin."""

    def __init__(self, manual):
        self.manual = manual
        self.pool = ThreadPoolExecutor(64)
        self.lock = threading.Lock()
        self.wake = threading.Event()
        self.interval = 10.0
        self.gen = 0             # bumps whenever a control starts or finishes
        self.inflight = 0        # controls sent but not yet answered
        self.force = True        # send the next status even if nothing changed
        self.seq = 0             # polls started
        self.shown = 0           # newest poll whose answer was sent
        self.last = ""
        self.preferred = []
        self.uuids = {}          # coordinator ip -> uuid, for play-uri
        self.hosts = []          # every speaker, for spare connections
        self.searched_on = None  # networks the last speaker search ran on
        self.searched_at = 0.0
        self.volumes = {}        # (cmd, ip) -> newest level not yet sent
        self.query = None
        self.searching = False
        self.spotify = SpotifyApi()
        self.service = None      # the household's Spotify id in Sonos, once known
        self.data = {"groups": [], "rooms": []}
        self.focus = ""          # group the widget points at; media keys control it
        self.mpris = None
        if MPRIS:
            try:
                self.mpris = Mpris(self)
            except Exception:
                pass

    def failed(self, cmd, ip, error):
        self.emit({"type": "failed", "cmd": cmd, "ip": ip, "error": describe(error)})

    def focused(self):
        groups = self.data["groups"]
        return (next((g for g in groups if g["ip"] == self.focus), None)
                or next((g for g in groups if g["state"] == "PLAYING"), None)
                or (groups[0] if groups else None))

    def emit(self, obj):
        line = json.dumps(obj)
        with self.lock:
            sys.stdout.write(line + "\n")
            sys.stdout.flush()

    def poke(self, *delays):
        """Poll right away or after the delays, alongside any poll already running."""
        for d in delays:
            if d:
                threading.Timer(d, self.pool.submit, (self.poll,)).start()
            else:
                self.pool.submit(self.poll)

    def begin(self):
        with self.lock:
            self.gen += 1
            self.inflight += 1
            self.force = True

    def end(self, *confirm):
        with self.lock:
            self.gen += 1
            self.inflight -= 1
        self.poke(*confirm)
        self.keep_spares()

    def keep_spares(self):
        """Give every speaker a fresh spare connection while the popup is open."""
        if self.interval > 2:
            return
        now = time.monotonic()
        with spares_lock:
            stale = [ip for ip in self.hosts if now - spares.get(ip, (None, 0))[1] > SPARE_AGE - 2]
        for ip in stale:
            self.pool.submit(add_spare, ip)

    def drop_spares(self):
        with spares_lock:
            old = list(spares.values())
            spares.clear()
        for sock, _ in old:
            sock.close()

    def run_control(self, cmd, ip, arg, extra, confirm):
        try:
            control(cmd, ip, arg, extra)
        except Exception as e:
            self.failed(cmd, ip, e)
        finally:
            self.end(*confirm)

    def regroup(self, cmd, ip):
        """Join every room into ip's group, or split every group into single rooms."""
        rooms = self.data["rooms"]
        if cmd == "group-all":
            uuid = self.uuids.get(ip)
            moves = [("join", r["ip"], uuid) for r in rooms if r["group"] != ip]
        else:
            moves = [("leave", r["ip"], None) for r in rooms if r["group"] != r["ip"]]
        self.begin()

        def go():
            futures = [(m, self.pool.submit(control, *m)) for m in moves]
            for (c, room, _), fut in futures:
                try:
                    fut.result()
                except Exception as e:
                    self.failed(c, room, e)
            self.end(0.25, 1.0)
        self.pool.submit(go)

    # Volume drags send many levels; each speaker gets one command at a time and
    # always the newest level, so they can never land out of order.
    def set_volume(self, cmd, ip, level):
        key = (cmd, ip)
        with self.lock:
            busy = key in self.volumes
            self.volumes[key] = level
        if not busy:
            self.begin()
            self.pool.submit(self.volume_worker, key)

    def set_group_volume(self, ip, level):
        """Scale each speaker in the group from the last status, as the Sonos app does.
        Some coordinators (e.g. one behind a Wi-Fi extender) accept SetGroupVolume and
        change nothing, so the group volume is only used when the members are unknown."""
        level = max(0, min(100, level))
        with self.lock:
            group = next((g for g in self.data["groups"] if g["ip"] == ip), None)
            members = [(r["ip"], r.get("volume", 0)) for r in self.data["rooms"] if r.get("group") == ip]
        if not group or not members:
            self.set_volume("volume", ip, level)
            return
        base = group.get("volume", 0)
        for member, volume in members:
            scaled = volume * level / base if base > 0 else level
            self.set_volume("speaker-volume", member, max(0, min(100, round(scaled))))

    def volume_worker(self, key):
        sent = None
        while True:
            with self.lock:
                level = self.volumes[key]
                if level == sent:
                    del self.volumes[key]
                    break
            try:
                control(key[0], key[1], level)
            except Exception as e:
                self.failed(key[0], key[1], e)
            sent = level
        self.end(0)

    def search(self, query):
        with self.lock:
            self.query = query
            if self.searching:
                return
            self.searching = True
        self.pool.submit(self.search_worker)

    def search_worker(self):
        while True:
            query = self.query
            try:
                found = my_playlists(self.spotify) if query == MY_PLAYLISTS else search(query, self.spotify)
                out = {"type": "search", "query": query, "results": found}
            except Exception as e:
                out = {"type": "search", "query": query, "error": str(e)}
            with self.lock:
                if self.query == query:
                    self.searching = False
                    break
        self.emit(out)

    def warm_spotify(self):
        try:
            if os.path.exists(SPOTIFY_CONF):
                spotify_token()
                self.spotify.warm()
        except Exception:
            pass

    def handle(self, msg):
        cmd, ip = msg.get("cmd"), msg.get("ip")
        if cmd == "watch":
            self.interval = float(msg.get("interval", 10))
            self.force = True
            self.wake.set()
            if self.interval > 2:
                self.drop_spares()
            else:
                self.keep_spares()
            if msg.get("warm"):
                self.pool.submit(self.warm_spotify)
        elif cmd == "refresh":
            self.force = True
            self.wake.set()
        elif cmd == "volume":
            self.set_group_volume(ip, int(msg["value"]))
        elif cmd == "speaker-volume":
            self.set_volume(cmd, ip, int(msg["value"]))
        elif cmd in CONTROLS:
            self.begin()
            # Track changes take a moment to show up, so look twice.
            confirm = (0.25, 1.0) if cmd in ("play", "next", "prev", "source", "lead") else (0.25,)
            self.pool.submit(self.run_control, cmd, ip, msg.get("arg"), msg.get("extra"), confirm)
        elif cmd in ("group-all", "ungroup-all"):
            self.regroup(cmd, ip)
        elif cmd == "focus":
            self.focus = ip or ""
            if self.mpris:
                self.mpris.update(self.focused())
        elif cmd == "play-uri":
            self.begin()

            def go():
                try:
                    self.service = self.service or spotify_service(ip)
                    play_uri(ip, msg["uri"], self.uuids.get(ip), self.service)
                except Exception as e:
                    self.failed(cmd, ip, e)
                finally:
                    self.end(0.25, 1.0)
            self.pool.submit(go)
        elif cmd == "search":
            self.search(msg.get("query", ""))

    def poll(self):
        with self.lock:
            gen, busy = self.gen, self.inflight
            self.seq += 1
            seq = self.seq
        if busy:
            return  # the control's answer pokes a fresh poll
        try:
            groups = self.find_groups()
            data = status(groups, self.pool)
            data["error"] = "" if groups else "No Sonos speakers found"
        except Exception as e:
            data = {"groups": [], "rooms": [], "error": str(e)}
        with self.lock:
            # A control ran meanwhile, or a newer poll already answered.
            if gen != self.gen or seq < self.shown:
                return
            self.shown = seq
            force, self.force = self.force, False
            for g in data["groups"]:
                self.uuids[g["ip"]] = g["uuid"]
            self.hosts = [r["ip"] for r in data["rooms"]]
            self.preferred = [data["groups"][0]["ip"]] if data["groups"] else []
            self.data = data
            # Position changes every second; only the media player needs it.
            shown = {**data, "groups": [{k: v for k, v in g.items() if k != "position"} for g in data["groups"]]}
            line = json.dumps(shown)
            changed = force or line != self.last
            self.last = line
        if self.mpris:
            self.mpris.update(self.focused())
        if changed:
            self.emit({"type": "status", **shown})

    def find_groups(self):
        """Never wait on speakers from another network; search for speakers
        only after joining a network or once a minute while the popup is open,
        so a network without speakers is never scanned over and over."""
        nets = local_networks()
        if not nets and not self.manual:
            raise RuntimeError("No network")
        groups = first_topology(known_hosts(self.manual, self.preferred, nets))
        now = time.monotonic()
        if not groups and (nets != self.searched_on or (self.interval <= 2 and now - self.searched_at > 60)):
            self.searched_on, self.searched_at = nets, now
            groups = first_topology(discover(nets))
        if groups:
            save_hosts(groups)
        return groups or []

    def poll_loop(self):
        while True:
            self.wake.wait(self.interval)
            self.wake.clear()
            self.pool.submit(self.poll)
            self.keep_spares()

    def run(self):
        threading.Thread(target=self.poll_loop, daemon=True).start()
        for line in sys.stdin:
            try:
                self.handle(json.loads(line))
            except Exception as e:
                self.emit({"type": "error", "error": str(e)})
        os._exit(0)


def main(argv):
    manual = []
    if len(argv) > 1 and argv[0] == "--hosts":
        manual = [h for h in argv[1].split(",") if h.strip()]
        argv = argv[2:]
    cmd = argv[0] if argv else "status"

    if cmd == "status":
        with ThreadPoolExecutor(32) as pool:
            print(json.dumps(status(load_groups(manual), pool)))
    elif cmd == "serve":
        Server(manual).run()
    elif cmd == "search":
        print(json.dumps({"results": search(" ".join(argv[1:]))}))
    elif cmd == "playlists":
        print(json.dumps({"results": my_playlists()}))
    elif cmd == "spotify-status":
        try:
            conf = spotify_conf()
        except RuntimeError:
            conf = {}
        print(json.dumps({"loggedIn": "refresh_token" in conf or "client_secret" in conf,
                          "clientId": conf.get("client_id", "")}))
    elif cmd == "spotify-login":
        client_id = argv[1].strip() if len(argv) > 1 else ""
        if not client_id:
            raise RuntimeError("Paste the Client ID first")
        spotify_login(client_id)
        print(json.dumps({"ok": True}))
    elif cmd == "spotify-logout":
        try:
            save_spotify_conf({"client_id": spotify_conf()["client_id"]})
        except (RuntimeError, KeyError):
            pass
        if os.path.exists(TOKEN_CACHE):
            os.remove(TOKEN_CACHE)
    elif cmd == "play-uri":
        play_uri(argv[1], argv[2], argv[3] if len(argv) > 3 else None)
    elif cmd in CONTROLS:
        control(cmd, *argv[1:4])
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except Exception as e:
        print(json.dumps({"error": str(e)}))
        sys.exit(1)
